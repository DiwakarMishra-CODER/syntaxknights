{
  "name": "ai-interview-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:llm": "tsx --env-file=.env.local scripts/test-llm.ts",
    "test:db": "tsx --env-file=.env.local scripts/test-db.ts",
    "plan": "tsx --env-file=.env.local scripts/plan.ts",
    "probe:quota": "tsx --env-file=.env.local scripts/probe-quota.ts",
    "quota:report": "tsx --env-file=.env.local scripts/quota-report.ts",
    "compare:turn": "tsx --env-file=.env.local scripts/compare-turn.ts",
    "interview": "tsx --env-file=.env.local scripts/interview.ts",
    "report:fixture": "tsx --env-file=.env.local scripts/report-from-fixture.ts",
    "conformance": "tsx --env-file=.env.local scripts/conformance.ts",
    "typecheck": "tsc --noEmit",
    "warm": "tsx --env-file=.env.local scripts/warm-blueprints.ts"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.109.0",
    "@types/three": "^0.185.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.30.0",
    "next": "15.5.23",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
